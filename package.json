{
  "name": "financial-cal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:local": "VITE_API_URL=http://localhost:8787 vite",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "clasp:push": "cd apps-script && clasp push",
    "clasp:deploy": "cd apps-script && clasp push && clasp deploy --description \"Financial Cal\"",
    "bundle": "node scripts/bundle-apps-script.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
