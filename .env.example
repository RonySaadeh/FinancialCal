# Public frontend configuration. It is compiled into the static site and
# visible to anyone, so it must never contain secrets (no passwords here!).
# Copy to .env.local for local development. For GitHub Pages, set the same name
# as a repository *variable* (Settings → Secrets and variables → Actions → Variables).

# Apps Script Web App URL (Deploy → Manage deployments → Web app URL, ends in /exec)
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Base path the site is served from. Defaults to /FinancialCal/ for builds.
# VITE_BASE_PATH=/FinancialCal/
