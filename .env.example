# Public frontend configuration. These values are compiled into the static site
# and visible to anyone, so they must never be secrets.
# Copy to .env.local for local development. For GitHub Pages, set the same names
# as repository *variables* (Settings → Secrets and variables → Actions → Variables).

# Apps Script Web App URL (Deploy → Manage deployments → Web app URL, ends in /exec)
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google OAuth 2.0 Web client ID (Google Cloud Console → APIs & Services → Credentials)
VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Base path the site is served from. Defaults to /FinancialCal/ for builds.
# VITE_BASE_PATH=/FinancialCal/

# Local development only: sign in against `npm run dev:backend` without Google.
# Ignored in production builds.
# VITE_DEV_AUTH=true
